// Vier shaped for a host: nothing at the top level runs until the last lines.


enum Player {
    red
    yellow
}

struct Position {
    column: int
    row: int
}

struct Board {
    cells: [[Option<Player>]]
}

func columns() -> int {
    return 7
}

func rows() -> int {
    return 6
}

func emptyBoard() -> Board {
    var cells: [[Option<Player>]]
    for row in 0..rows() {
        var line: [Option<Player>]
        for column in 0..columns() {
            line += none
        }
        cells += line
    }
    return Board(cells: cells)
}

func at(board: Board, column: int, row: int) -> Option<Player> {
    return board.cells[row][column]
}

func canDrop(board: Board, column: int) -> bool {
    if column < 0 || column >= columns() {
        return false
    }
    return at(board, column, rows() - 1) == none
}

func isFull(board: Board) -> bool {
    for column in 0..columns() {
        if canDrop(board, column) {
            return false
        }
    }
    return true
}

func landingRow(board: Board, column: int) -> int {
    var row = 0
    while at(board, column, row) != none {
        row += 1
    }
    return row
}

func dropped(board: Board, player: Player, column: int) -> Board {
    var next = board
    next.cells[landingRow(board, column)][column] = some(player)
    return next
}

func inside(column: int, row: int) -> bool {
    return column >= 0 && column < columns() && row >= 0 && row < rows()
}

func winningLines() -> [[Position]] {
    let steps = [[1, 0], [0, 1], [1, 1], [1, -1]]
    var all: [[Position]]
    for column in 0..columns() {
        for row in 0..rows() {
            for step in steps {
                if inside(column + step[0] * 3, row + step[1] * 3) {
                    var line: [Position]
                    for i in 0..4 {
                        line += Position(column: column + step[0] * i, row: row + step[1] * i)
                    }
                    all += line
                }
            }
        }
    }
    return all
}

func owner(board: Board, line: [Position]) -> Option<Player> {
    let first = at(board, line[0].column, line[0].row)
    for cell in line {
        if at(board, cell.column, cell.row) != first {
            return none
        }
    }
    return first
}

func winner(board: Board, candidates: [[Position]]) -> Option<Player> {
    for line in candidates {
        let found = owner(board, line)
        if found != none {
            return found
        }
    }
    return none
}

func name(player: Player) -> string {
    return match player {
        red => "Red"
        yellow => "Yellow"
    }
}

func mark(cell: Option<Player>) -> string {
    return match cell {
        some(let player) => match player {
            red => "R"
            yellow => "Y"
        }
        none => "."
    }
}


func picture(board: Board) -> string {
    var text = ""
    var row = rows() - 1
    while row >= 0 {
        for column in 0..columns() {
            text += " " + mark(at(board, column, row))
        }
        text += "\n"
        row -= 1
    }
    return text + " 1 2 3 4 5 6 7"
}

func computerColumn(board: Board) -> int {
    for column in [3, 2, 4, 1, 5, 0, 6] {
        if canDrop(board, column) {
            return column
        }
    }
    return -1
}

enum Phase {
    yourTurn
    computerThinking(column: int, dueAt: float)
    finished(message: string)
}

struct Game {
    board: Board
    phase: Phase
}

func fresh() -> Game {
    return Game(board: emptyBoard(), phase: Phase.yourTurn)
}

func afterDrop(board: Board, next: Phase) -> Game {
    let result = winner(board, winningLines())
    if result != none {
        return Game(board: board, phase: Phase.finished(message: match result {
            some(let player) => name(player) + " wins!"
            none => ""
        }))
    }
    if isFull(board) {
        return Game(board: board, phase: Phase.finished(message: "A draw."))
    }
    return Game(board: board, phase: next)
}

// The host calls this when you click a column.
func clicked(game: Game, column: int, now: float) -> Game {
    let waiting = match game.phase {
        yourTurn => true
        _ => false
    }
    if !waiting || !canDrop(game.board, column) {
        return game
    }
    let board = dropped(game.board, Player.red, column)
    let thinking = Phase.computerThinking(column: computerColumn(board), dueAt: now + 0.5)
    return afterDrop(board, thinking)
}

func computerMove(game: Game, column: int, dueAt: float, now: float) -> Game {
    if now < dueAt {
        return game
    }
    return afterDrop(dropped(game.board, Player.yellow, column), Phase.yourTurn)
}

// The host calls this on every frame.
func tick(game: Game, now: float) -> Game {
    return match game.phase {
        computerThinking(let column, let dueAt) => computerMove(game, column, dueAt, now)
        _ => game
    }
}

// The host calls this on every frame, and puts what it returns on the screen.
func draw(game: Game) -> string {
    let status = match game.phase {
        yourTurn => "Your turn."
        computerThinking(let _, let _) => "The computer is thinking..."
        finished(let message) => message
    }
    return picture(game.board) + "\n" + status
}

// Under a host, these last lines are the host's job. Here, you are the host:
// ten frames a second for three seconds, with a click at frame 2 and frame 12.
var game = fresh()
var shown = ""
for frame in 0..30 {
    let now = float(frame) / 10.0
    if frame == 2 {
        game = clicked(game, 3, now)
    }
    if frame == 12 {
        game = clicked(game, 4, now)
    }
    game = tick(game, now)
    let screen = draw(game)
    if screen != shown {
        print("frame", frame)
        print(screen)
        shown = screen
    }
}
